unit ugConfiguration.TreeMove;
interface
uses System.Classes,System.SysUtils,ugConfiguration.TreePlan;
procedure AddTreeMoves(Code:TStrings;const P:TTreePlan);
procedure AddTreeMoveAvailability(Code:TStrings;const P:TTreePlan);
implementation
procedure AddTreeMoveAvailability(Code:TStrings;const P:TTreePlan);
  procedure A(const S:string);begin Code.Add(S);end;
begin
  A('//只读取本地暂存副本判断移动边界，不移动当前游标或发起数据库查询');
  A('procedure TreeMoveAvailability(var CanUp, CanDown, CanLeft, CanRight: Boolean);');
  A('var C: TUgClientDataSet; K, ParentKey: string; Found, BeforeCurrent: Boolean;');A('begin');
  A('  CanUp := False; CanDown := False; CanLeft := False; CanRight := False;');
  A('  if not cdsMain.Active or cdsMain.IsEmpty then Exit;');
  A('  K := cdsMain.FieldByName('+QuotedStr(P.KeyField)+').AsString;');
  A('  ParentKey := cdsMain.FieldByName('+QuotedStr(P.ParentField)+').AsString;');
  A('  C := TUgClientDataSet.Create(nil);');A('  try');
  A('    C.Data := cdsMain.Data; C.IndexFieldNames := '+QuotedStr(P.OrderField+';'+P.KeyField)+';');
  A('    if ParentKey <> '''' then CanLeft := C.Locate('+QuotedStr(P.KeyField)+', ParentKey, 0);');
  A('    Found := False; BeforeCurrent := False; C.First;');
  A('    while not C.Eof do begin');
  A('      if C.FieldByName('+QuotedStr(P.ParentField)+').AsString = ParentKey then begin');
  A('        if C.FieldByName('+QuotedStr(P.KeyField)+').AsString = K then begin');
  A('          CanUp := BeforeCurrent; Found := True;');
  A('        end else if Found then CanDown := True else BeforeCurrent := True;');
  A('      end; C.Next;');A('    end;');A('    CanRight := CanUp;');
  A('  finally C.Free; end;');A('end;');
end;
procedure AddTreeMoves(Code:TStrings;const P:TTreePlan);
  procedure A(const S:string);begin Code.Add(S);end;
begin
  A('//按稳定节点键收集同级节点，不依赖树的展开状态或界面行号');
  A('procedure TreeSiblings(const ParentKey: string; Keys: TStringList);');
  A('var C: TUgClientDataSet;');A('begin');
  A('  Keys.Clear; C := TUgClientDataSet.Create(nil);');A('  try');
  A('    C.Data := cdsMain.Data; C.IndexFieldNames := '+QuotedStr(P.OrderField+';'+P.KeyField)+';');
  A('    C.First; while not C.Eof do begin');
  A('      if C.FieldByName('+QuotedStr(P.ParentField)+').AsString = ParentKey then');
  A('        Keys.Add(C.FieldByName('+QuotedStr(P.KeyField)+').AsString);');
  A('      C.Next;');A('    end;');A('  finally C.Free; end;');A('end;');
  A('//重排指定同级列表，子树中的父键及主键不变');
  A('procedure SetTreeSiblingOrder(const ParentKey: string; Keys: TStringList);');
  A('var I: Integer; V: string;');A('begin');
  A('  if Keys.Count > 100000 then RaiseException(UGMM.LT(''同级节点数量超过五位排序容量。''));');
  A('  for I := 0 to Keys.Count - 1 do begin');
  A('    if not cdsMain.Locate('+QuotedStr(P.KeyField)+', Keys[I], 0) then');
  A('      RaiseException(UGMM.LT(''待移动节点已变化。''));');
  A('    V := ParentKey + ''_'' + Format(''%.5d'', [I]);');
  A('    if (cdsMain.FieldByName('+QuotedStr(P.OrderField)+').Size > 0) and');
  A('      (Length(V) > cdsMain.FieldByName('+QuotedStr(P.OrderField)+').Size) then');
  A('      RaiseException(UGMM.LT(''排序字段长度不足。''));');
  A('    if (cdsMain.FieldByName('+QuotedStr(P.ParentField)+').AsString <> ParentKey) or');
  A('      (cdsMain.FieldByName('+QuotedStr(P.OrderField)+').AsString <> V) then begin');
  A('      cdsMain.Edit;');
  A('      cdsMain.FieldByName('+QuotedStr(P.ParentField)+').AsString := ParentKey;');
  A('      cdsMain.FieldByName('+QuotedStr(P.OrderField)+').AsString := V;');
  A('      cdsMain.Post;');A('    end;');A('  end;');A('end;');
  A('//方向 0上、1下、2左、3右；失败恢复本次操作前的完整暂存');
  A('procedure MoveTreeNode(Direction: Integer);');
  A('var K, ParentKey, TargetParent, SwapKey, Failure: string;');
  A('  Keys, TargetKeys: TStringList; I, J: Integer; PreviousData: Variant;');
  A('begin');A('  if cdsMain.IsEmpty then Exit;');
  A('  K := cdsMain.FieldByName('+QuotedStr(P.KeyField)+').AsString;');
  A('  ParentKey := cdsMain.FieldByName('+QuotedStr(P.ParentField)+').AsString;');
  A('  PreviousData := cdsMain.Data; Keys := TStringList.Create; TargetKeys := TStringList.Create;');
  A('  cdsMain.DisableControls;');A('  try');A('    try');
  A('      ValidateGenericRows; TreeSiblings(ParentKey, Keys); I := FindTreeKey(Keys, K);');
  A('      if I < 0 then RaiseException(UGMM.LT(''找不到当前同级节点。''));');
  A('      if (Direction = 0) or (Direction = 1) then begin');
  A('        J := I - 1; if Direction = 1 then J := I + 1;');
  A('        if (J < 0) or (J >= Keys.Count) then RaiseException(UGMM.LT(''节点已到同级边界，不能继续移动。''));');
  A('        SwapKey := Keys[J]; Keys[J] := Keys[I]; Keys[I] := SwapKey;');
  A('        SetTreeSiblingOrder(ParentKey, Keys);');
  A('      end else begin');
  A('        if Direction = 2 then begin');
  A('          if ParentKey = '''' then RaiseException(UGMM.LT(''根节点不能再向左移动。''));');
  A('          if not cdsMain.Locate('+QuotedStr(P.KeyField)+', ParentKey, 0) then');
  A('            RaiseException(UGMM.LT(''父节点不在当前权限范围内，不能向左移动。''));');
  A('          TargetParent := cdsMain.FieldByName('+QuotedStr(P.ParentField)+').AsString;');
  A('        end else if Direction = 3 then begin');
  A('          if I = 0 then RaiseException(UGMM.LT(''首个同级节点不能向右移动。''));');
  A('          TargetParent := Keys[I - 1];');
  A('        end else RaiseException(UGMM.LT(''无效的节点移动方向。''));');
  A('        TreeSiblings(TargetParent, TargetKeys); TargetKeys.Add(K); Keys.Delete(I);');
  A('        SetTreeSiblingOrder(TargetParent, TargetKeys); SetTreeSiblingOrder(ParentKey, Keys);');
  A('      end;');A('      ValidateGenericRows;');
  A('    except Failure := ExceptionMessage; cdsMain.Cancel; cdsMain.Data := PreviousData; RaiseException(Failure); end;');
  A('  finally Keys.Free; TargetKeys.Free;');
  A('    cdsMain.Locate('+QuotedStr(P.KeyField)+', K, 0); cdsMain.EnableControls;');
  A('    //仅刷新树视图，按当前暂存数据重建层级，不重新查询或提交数据库');
  A('    treeMain.Refresh;');
  A('  end; treeMain.FullExpand;');A('end;');
end;
end.
