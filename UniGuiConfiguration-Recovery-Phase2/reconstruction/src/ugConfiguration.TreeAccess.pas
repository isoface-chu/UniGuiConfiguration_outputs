unit ugConfiguration.TreeAccess;
interface
uses System.Classes,System.SysUtils,ugConfiguration.TreePlan;
procedure AddTreeAccess(Code:TStrings;const P:TTreePlan;const DepartmentField:string);
implementation
procedure AddTreeAccess(Code:TStrings;const P:TTreePlan;const DepartmentField:string);
  procedure A(const S:string);begin Code.Add(S);end;
begin
  A('//权限名称仅作为转义后的SQL值；空权限返回空集合，不允许退化为全表');
  A('var LoadedTreeScope: string = '''';');
  A('function GetTreeScope: string;');A('var Names: TStringList; I: Integer; V: string;');A('begin');
  A('  Result := ''''; Names := TStringList.Create;');A('  try');
  A('    Names.Text := ReplaceText(UGMM.Informations.Values[''ClassName''] + '';'' + UGMM.Informations.Values[''SubClassName''], '';'', #13#10);');
  A('    for I := 0 to Names.Count - 1 do begin');A('      V := Trim(Names[I]); if V <> '''' then begin');
  A('        if Result <> '''' then Result := Result + '',''; Result := Result + QuotedStr(V);');A('      end;');A('    end;');
  A('    if Result = '''' then Result := ''(NULL)'' else Result := ''('' + Result + '')'';');
  A('  finally Names.Free; end;');A('end;');
  A('//仅在服务器端核对关系，不把权限范围外节点绑定给浏览器');
  A('procedure CheckTreeSiblingScope(const ParentKey: string);');
  A('var C, L, D: TUgClientDataSet; K: string; Removed: Boolean;');A('begin');
  A('  if GetTreeScope <> LoadedTreeScope then RaiseException(UGMM.LT(''权限范围已变化，请先撤销并重新打开模块。''));');
  A('  C := TUgClientDataSet.Create(nil); L := TUgClientDataSet.Create(nil); D := TUgClientDataSet.Create(nil);');
  A('  try');A('    L.Data := cdsMain.Data;');
  A('    if cdsMain.ChangeCount > 0 then D.Data := cdsMain.Delta else D.Data := cdsMain.Data;');
  A('    C.DataNodeName := cDataNodeName;');
  A('    C.PageRowCount := -1; C.SelectMaxRecCount := 0;');
  A('    if ParentKey = '''' then');
  A('      C.CommandText := '+QuotedStr('select '+P.KeyField+' from '+P.TableName+' where '+P.ParentField+' is null or '+P.ParentField+' = :parent') );
  A('    else C.CommandText := '+QuotedStr('select '+P.KeyField+' from '+P.TableName+' where '+P.ParentField+' = :parent')+';');
  A('    C.ParamByName(''parent'').AsString := ParentKey; C.Open;');
  A('    while not C.Eof do begin');A('      K := C.FieldByName('+QuotedStr(P.KeyField)+').AsString; Removed := False;');
  A('      if not L.Locate('+QuotedStr(P.KeyField)+', K, 0) then begin');
  A('        D.First; while not D.Eof do begin');
  A('          if (D.UpdateStatus = usDeleted) and (D.FieldByName('+QuotedStr(P.KeyField)+').AsString = K) then Removed := True;');
  A('          D.Next;');A('        end;');
  A('        if not Removed then RaiseException(UGMM.LT(''关联节点不在当前可操作范围内，请勿移动或删除该分支。''));');
  A('      end; C.Next;');A('    end;');A('  finally D.Free; L.Free; C.Free; end;');A('end;');
  A('//重新检查待提交节点的归属，防止加载后权限或后台归属已发生变化');
  A('procedure CheckTreeWriteScope;');
  A('var D, C: TUgClientDataSet; Names: TStringList; V, K: string; I, Pass: Integer; Allowed: Boolean;');A('begin');
  A('  if GetTreeScope <> LoadedTreeScope then RaiseException(UGMM.LT(''权限范围已变化，请先撤销并重新打开模块。''));');
  A('  if cdsMain.ChangeCount = 0 then Exit;');
  A('  D := TUgClientDataSet.Create(nil); C := TUgClientDataSet.Create(nil); Names := TStringList.Create;');A('  try');
  A('    Names.Text := ReplaceText(UGMM.Informations.Values[''ClassName''] + '';'' + UGMM.Informations.Values[''SubClassName''], '';'', #13#10);');
  A('    C.DataNodeName := cDataNodeName; C.PageRowCount := 1;');
  A('    for Pass := 0 to 1 do begin');
  A('    if Pass = 0 then D.Data := cdsMain.Data else D.Data := cdsMain.Delta; D.First;');
  A('    while not D.Eof do begin');
  A('      if ((Pass = 0) and (D.UpdateStatus <> usUnmodified)) or');
  A('        ((Pass = 1) and (D.UpdateStatus = usDeleted)) then begin');
  A('      V := D.FieldByName('+QuotedStr(DepartmentField)+').AsString; Allowed := False;');
  A('      for I := 0 to Names.Count - 1 do if (Trim(Names[I]) <> '''') and (Trim(Names[I]) = V) then Allowed := True;');
  A('      if not Allowed then RaiseException(UGMM.LT(''节点归属不在当前权限范围内。''));');
  A('      if D.UpdateStatus <> usInserted then begin');
  A('        K := D.FieldByName('+QuotedStr(P.KeyField)+').AsString; C.Close;');
  A('        C.CommandText := '+QuotedStr('select '+P.KeyField+' from '+P.TableName+' where '+P.KeyField+' = :node and '+DepartmentField+' in ')+' + GetTreeScope;');
  A('        C.ParamByName(''node'').AsString := K; C.Open;');
  A('        if C.IsEmpty then RaiseException(UGMM.LT(''节点已变化或不再属于当前权限范围，请重新加载。''));');A('      end;');
  A('      if D.UpdateStatus = usDeleted then CheckTreeSiblingScope(D.FieldByName('+QuotedStr(P.KeyField)+').AsString);');
  A('      end; D.Next;');A('    end;');A('    end;');
  A('  finally Names.Free; C.Free; D.Free; end;');A('end;');
end;
end.
